# =====================================================
# Olist Ecommerce Data Pipeline
# .gitignore
# =====================================================

# -----------------------------------------------------
# Environment Variables & Secrets
# -----------------------------------------------------

.env
.env.*
!.env.example
*.secret
*.secrets
*.key
*.pem
*.crt
*.p12
*.jks

# -----------------------------------------------------
# Operating System Files
# -----------------------------------------------------

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------
# Python
# -----------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so
*.egg
*.egg-info/
dist/
build/
develop-eggs/
eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.cache/

# Type checking
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# -----------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------

.ipynb_checkpoints/

# -----------------------------------------------------
# Apache Airflow
# -----------------------------------------------------

airflow/logs/
airflow/logs/**
logs/

# Airflow local databases
airflow.db
airflow.db-journal

# Airflow generated files
airflow/__pycache__/
airflow/plugins/__pycache__/
airflow/dags/__pycache__/

# Airflow configuration containing local settings
airflow.cfg

# -----------------------------------------------------
# Hadoop / HDFS Generated Data
# -----------------------------------------------------

# Do not commit local Hadoop/HDFS data
hadoop/data/raw/
hadoop/data/staging/
hadoop/data/quality/
hadoop/data/warehouse/

# HDFS temporary/system files
hadoop/data/**/_temporary/
hadoop/data/**/_SUCCESS
hadoop/data/**/.crc

# Hadoop logs
hadoop/logs/
hadoop/log/
*.hadoop.log

# Hadoop temporary files
hadoop/tmp/
hadoop/dfs/
hadoop/namenode/
hadoop/datanode/

# -----------------------------------------------------
# Olist Source Datasets
# -----------------------------------------------------

# Raw datasets should normally not be committed to Git
datasets/*.csv
datasets/*.CSV

# Large data files
*.csv
*.csv.gz
*.tsv
*.json
*.json.gz

# Parquet / ORC / Avro data
*.parquet
*.orc
*.avro

# -----------------------------------------------------
# IMPORTANT:
# Keep small configuration/metadata JSON files if needed.
# If the project contains JSON configuration files that
# should be version controlled, use explicit negation rules.
# -----------------------------------------------------

# Example:
# !config/*.json

# -----------------------------------------------------
# Apache Spark
# -----------------------------------------------------

spark/logs/
spark/tmp/
spark/work/
spark/history/
spark-events/
spark-warehouse/

# Spark generated output
spark/output/
spark/checkpoints/
spark/checkpoint/

# Spark local metadata
.metastore/
derby.log

# -----------------------------------------------------
# Apache Iceberg
# -----------------------------------------------------

# Generated Iceberg warehouse data
iceberg/data/
iceberg/warehouse/
iceberg/tables/

# Iceberg metadata generated locally
**/metadata/
**/snapshots/
**/manifests/

# -----------------------------------------------------
# Hive
# -----------------------------------------------------

hive/logs/
hive/tmp/
hive/warehouse/
hive/data/

# Hive local metadata
hive-site.xml
hivemetastore-site.xml

# -----------------------------------------------------
