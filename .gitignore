# -----------------------------------------------------

docker-compose.override.yml
.docker/
docker-data/
docker-volumes/

# Docker logs
docker-logs/

# -----------------------------------------------------
# Test / Temporary Data
# -----------------------------------------------------

tests/data/
tests/output/
tests/tmp/
test-results/
test-output/

