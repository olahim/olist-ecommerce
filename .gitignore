# -----------------------------------------------------

*.pid
*.sock

# -----------------------------------------------------
# Generated Documentation
# -----------------------------------------------------

docs/_build/
site/

# -----------------------------------------------------
# Keep Important Project Files
# -----------------------------------------------------

!.gitkeep
!.env.example
!README.md
!Makefile
!requirements.txt
!requirements/*.txt

# Keep source code
!airflow/dags/**/*.py
!airflow/plugins/**/*.py
!spark/jobs/**/*.py
!spark/scripts/**/*.sh
!spark/notebooks/**/*.ipynb
!scripts/**/*.sh
!tests/**/*.py

# Keep SQL
!trino/queries/**/*.sql
!hive/scripts/**/*.sql
!iceberg/scripts/**/*.sql

# Keep documentation
!docs/**/*.md
!docs/**/*.rst
