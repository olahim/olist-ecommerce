# =====================================================
# Olist Ecommerce Pipeline - Environment Configuration
# =====================================================
# Copy this file to .env and update values as needed
# =====================================================

# =====================================================
# General Configuration
# =====================================================
PROJECT_NAME=olist-ecommerce
PROJECT_VERSION=2.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# =====================================================
# Data Lake Configuration
# =====================================================
DATA_LAKE_BASE=/opt/hadoop/data
DATA_LAKE_RAW=${DATA_LAKE_BASE}/raw
DATA_LAKE_STAGING=${DATA_LAKE_BASE}/staging
DATA_LAKE_QUALITY=${DATA_LAKE_BASE}/quality
DATA_LAKE_WAREHOUSE=${DATA_LAKE_BASE}/warehouse

# Iceberg Configuration
ICEBERG_WAREHOUSE=${DATA_LAKE_WAREHOUSE}/iceberg
ICEBERG_CATALOG=spark_catalog
ICEBERG_CATALOG_TYPE=hive

# =====================================================
# PostgreSQL (Hive Metastore) Configuration
# =====================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metastore
POSTGRES_USER=hive
POSTGRES_PASSWORD=changeme
POSTGRES_METASTORE_URI=thrift://localhost:9083

# =====================================================
# Apache Hive Configuration
# =====================================================
HIVE_METASTORE_URIS=thrift://localhost:9083
HIVE_WAREHOUSE=/user/hive/warehouse

# =====================================================
# Apache Spark Configuration
# =====================================================
SPARK_HOME=/opt/spark
SPARK_MASTER=yarn
SPARK_DEPLOY_MODE=cluster
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=2
SPARK_NUM_EXECUTORS=4
SPARK_DRIVER_MEMORY=2g

# Iceberg Spark Configurations
SPARK_SQL_EXTENSIONS=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
SPARK_SQL_CATALOG_SPARK_CATALOG=org.apache.iceberg.spark.SparkCatalog
SPARK_SQL_CATALOG_SPARK_CATALOG_TYPE=hive
SPARK_SQL_ADAPTIVE_ENABLED=true
SPARK_SQL_ADAPTIVE_COALESCE_PARTITIONS_ENABLED=true

# =====================================================
# Apache Airflow Configuration
# =====================================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__DAGS_FOLDER=${AIRFLOW_HOME}/dags
AIRFLOW__CORE__PLUGINS_FOLDER=${AIRFLOW_HOME}/plugins
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=False
AIRFLOW__SCHEDULER__MAX_ACTIVE_RUNS_PER_DAG=1

# Airflow Connections
AIRFLOW_CONN_SPARK_DEFAULT=spark://localhost:7077
AIRFLOW_CONN_HIVE_DEFAULT=hive://localhost:10000
AIRFLOW_CONN_TRINO_DEFAULT=trino://localhost:8080
AIRFLOW_CONN_POSTGRES_METASTORE=postgresql://hive:changeme@localhost:5432/metastore

# =====================================================
# Trino Configuration
# =====================================================
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_CATALOG=iceberg
TRINO_SCHEMA=olist_warehouse

# =====================================================
# Apache Superset Configuration
# =====================================================
SUPERSET_HOST=localhost
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=your-secret-key-here-change-in-production
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin123
SUPERSET_ADMIN_EMAIL=admin@olist.com

# =====================================================
# Data Quality Configuration
# =====================================================
DQ_SLA_THRESHOLD=95
DQ_ALERT_ENABLED=true
DQ_QUARANTINE_ENABLED=true
DQ_FAILED_RECORDS_PATH=${DATA_LAKE_QUALITY}/failed_records
DQ_REPORTS_PATH=${DATA_LAKE_QUALITY}/dq_reports
DQ_METRICS_PATH=${DATA_LAKE_QUALITY}/dq_metrics

# =====================================================
# Alerting Configuration (Slack)
# =====================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#data-quality-alerts
SLACK_USERNAME=Olist DQ Bot

# =====================================================
# Alerting Configuration (Email)
# =====================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@olist.com
SMTP_PASSWORD=your-smtp-password
ALERT_FROM_EMAIL=data-quality@olist.com
ALERT_TO_EMAIL=data-team@olist.com,engineering@olist.com

# =====================================================
# AWS Configuration (for external stages)
# =====================================================
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=olist-data-bucket

# =====================================================
# Monitoring Configuration
# =====================================================
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# =====================================================
# Development Configuration
# =====================================================
# Set to true for local development (uses local Spark master)
DEV_MODE=false
DEV_SPARK_MASTER=local[*]
DEV_DATA_SAMPLE_SIZE=10000

# =====================================================
# Performance Tuning
# =====================================================
# Spark performance
SPARK_SHUFFLE_PARTITIONS=200
SPARK_SQL_BROADCAST_TIMEOUT=300
SPARK_NETWORK_TIMEOUT=800s
SPARK_EXECUTOR_HEARTBEAT_INTERVAL=60s

# Iceberg performance
ICEBERG_WRITE_TARGET_FILE_SIZE_BYTES=536870912  # 512 MB
ICEBERG_WRITE_DISTRIBUTION_MODE=hash
ICEBERG_DELETE_DISTRIBUTION_MODE=hash

# =====================================================
# Feature Flags
# =====================================================
ENABLE_ICEBERG_OPTIMIZATION=true
ENABLE_DQ_CHECKS=true
ENABLE_METRICS_EXPORT=true
ENABLE_BACKUP=true
